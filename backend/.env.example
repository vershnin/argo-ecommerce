# Copy this file to backend/.env and update values for your environment

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/argo_ecommerce
SPRING_DATASOURCE_USERNAME=argo
SPRING_DATASOURCE_PASSWORD=argo_secret_123
# Required: generate with: openssl rand -base64 32
# Must be at least 256 bits. App will not start without this.
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MS=86400000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000
APP_BASE_URL=http://localhost:8080
APP_STORAGE_PATH=${user.home}/argo-uploads

# Optional S3 configuration (enable with spring.profiles.active=s3)
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_BASE_URL=

# Optional email configuration for order notifications
APP_NOTIFICATIONS_ENABLED=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true
APP_NOTIFICATIONS_FROM=no-reply@argo.com
